# Keep loopback unless an authenticated, rate-limited reverse proxy fronts the app.
MASTRA_HOST=127.0.0.1
# RESUME_BOT_ALLOW_PUBLIC=true

# Optional. Defaults target a local OmniRoute gateway with no authentication.
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_TIMEOUT_MS=60000
OMNIROUTE_ANSWER_MODEL=codex/gpt-5.6-luna-low
