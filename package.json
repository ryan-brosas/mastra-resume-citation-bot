{
  "name": "ryans-resume-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "citations:build": "node --experimental-strip-types src/citations/cli.ts build",
    "citations:verify": "node --experimental-strip-types src/citations/cli.ts verify",
    "ask": "node --experimental-strip-types scripts/ask.ts"
  },
  "dependencies": {
    "@mastra/core": "1.52.1",
    "@mastra/libsql": "1.17.0",
    "@mastra/loggers": "1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "mastra": "1.20.1",
    "typescript": "^5.9.3"
  }
}
